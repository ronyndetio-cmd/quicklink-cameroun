# Optional — /api/ai/chat falls back to a canned bilingual reply without this.
GEMINI_API_KEY=

# Fapshi (https://fapshi.com) — mobile money collection for the 250 FCFA unlock.
# Leave unset to run the built-in payment simulator (same request/response shape).
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_ENV=sandbox

# Supabase — persistence layer for production scale. Leave unset to keep
# the in-memory dev store (resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Only needed if the frontend and API are deployed separately --------

# Backend (Railway) — comma-separated list of frontend origin(s) allowed to
# call this API, e.g. https://quicklink-cameroun.netlify.app. Leave unset
# for same-origin deploys and local dev (permissive by default, safe since
# there's no cookie/session auth here).
CORS_ORIGIN=

# Frontend (Netlify) — the API's full URL, e.g.
# https://quicklink-cameroun.up.railway.app/api. Leave unset when the
# frontend is served by this same Express app (same-origin '/api' is used).
# Must be set at BUILD time (Netlify build environment variable), not
# runtime — Vite bakes it into the client bundle.
VITE_API_URL=
