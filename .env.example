# Groq (https://console.groq.com) — powers /api/ai/chat and the FR/EN post
# translator. Optional — both fall back to canned replies / the free
# MyMemory translation API without it. GROQ_MODEL lets you override the
# model id if the default one is ever retired (see console.groq.com/docs/models).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Fapshi (https://fapshi.com) — mobile money collection for the 250 FCFA unlock.
# Leave unset to run the built-in payment simulator (same request/response shape).
# FAPSHI_WEBHOOK_SECRET is optional — set it to whatever secret you configure
# on the Fapshi dashboard for this service, and /api/payments/webhook will
# verify the `x-wh-secret` header on every incoming call.
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_ENV=sandbox
FAPSHI_WEBHOOK_SECRET=

# Supabase — persistence layer for production scale. Leave unset to keep
# the in-memory dev store (resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# "Forgot password" codes can go by SMS (to the phone on file) or email (if
# the account has one saved). SMS isn't wired to a real gateway yet — it's
# always simulated (the 6-digit code comes back directly in the API
# response as `devCode` instead of being texted). Email is real once
# EMAIL_API_KEY is set: a Resend (https://resend.com) API key — sign up,
# Dashboard -> API Keys -> Create API Key. Free tier, no card needed.
# EMAIL_FROM overrides the sender once you've verified your own domain in
# Resend; until then it defaults to their shared onboarding@resend.dev
# address, which only delivers to the email your Resend account was
# created with — fine to test the flow yourself, not for real users.
SMS_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM=

# Mapbox (https://mapbox.com) — swaps the map's basemap for Mapbox's
# "Streets" style: colorful, rounded cartography with buildings, residential
# streets, and place labels down to neighborhood/quarter level. Optional —
# leave unset and the map uses the free, no-key OpenStreetMap/CARTO/Esri
# layers instead (Plan/Clair/Satellite), just without this richer style.
# Sign up free at mapbox.com -> Account -> Tokens -> copy the default public
# token (starts with "pk."). Must be set at BUILD time (Vite bakes it into
# the client bundle), same as VITE_API_URL below.
VITE_MAPBOX_TOKEN=

# --- Only needed if the frontend and API are deployed separately --------

# Backend (Railway) — comma-separated list of frontend origin(s) allowed to
# call this API, e.g. https://quicklink-cameroun.netlify.app. Leave unset
# for same-origin deploys and local dev (permissive by default, safe since
# there's no cookie/session auth here).
CORS_ORIGIN=

# Frontend (Netlify) — the API's full URL, e.g.
# https://quicklink-cameroun.up.railway.app/api. Leave unset when the
# frontend is served by this same Express app (same-origin '/api' is used).
# Must be set at BUILD time (Netlify build environment variable), not
# runtime — Vite bakes it into the client bundle.
VITE_API_URL=
